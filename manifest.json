{
  "manifest_version": 3,
  "name": "PLaMo Translator",
  "version": "0.1.0",
  "description": "選択テキストやサイドバーに入力したテキストをローカルの ollama (PLaMo 3 Translate) で翻訳します。",
  "browser_specific_settings": {
    "gecko": {
      "id": "plamo-translator@joker1007.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "defaults.js",
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "PLaMo 翻訳",
    "default_panel": "sidebar.html",
    "open_at_install": false
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "commands": {
    "translate-to-ja": {
      "suggested_key": {
        "default": "Ctrl+Alt+J"
      },
      "description": "選択テキストを日本語へ翻訳"
    },
    "translate-from-ja": {
      "suggested_key": {
        "default": "Ctrl+Alt+E"
      },
      "description": "選択テキストを日本語から設定言語へ翻訳"
    },
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "翻訳サイドバーを開く / 閉じる"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
